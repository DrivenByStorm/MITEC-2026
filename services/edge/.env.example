# Copy to .env and fill in. The edge service reads this file on start.
# Needed for the site agent (Claude). Without it the twin still runs; the chat says the agent is offline.
ANTHROPIC_API_KEY=
# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_PROACTIVE=1            # 0 = the agent only answers, never speaks up on its own
# AGENT_MIN_INTERVAL_S=20      # least time between unprompted agent messages
# SELECTION_ALGORITHM=my_module:select   # the real survey selection algorithm
# EDGE_HOST=127.0.0.1          # 0.0.0.0 to serve tablets on the site network
